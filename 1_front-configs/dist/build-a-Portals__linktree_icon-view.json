{
  "name": "Linktree Icon View",
  "framework": "vanilla",
  "port": 8020,
  "src": "src",
  "dist": "dist",
  "build": [
    {
      "_doc": "No data_wrap step, unlike linktree_mindmap. This portal imports the linktree JSON directly in TypeScript (see modules/data-from-linktree.ts), so esbuild inlines it at build time — there is nothing to fetch at runtime and therefore no data-*.json.js companions to emit or copy.",
      "mod": "esbuild",
      "input": "src/typescript/main.ts",
      "output": "script.js",
      "format": "iife",
      "target": "es2020"
    },
    {
      "mod": "sass",
      "input": "src/scss/main.scss",
      "output": "style.css"
    },
    {
      "mod": "copy",
      "files": "*.html",
      "from": "src"
    },
    {
      "mod": "symlink",
      "files": "public"
    },
    {
      "_doc": "Inject navigator.serviceWorker.register(...) before </head>. MUST run BEFORE esbuild_sw so the modified HTML feeds into BUILD_HASH.",
      "mod": "sw_register",
      "files": "index.html"
    },
    {
      "_doc": "Inject single-namespace observability SDK. Mirrors console.* + errors + SW lifecycle to OPFS console.log.",
      "mod": "console_log",
      "files": "index.html"
    },
    {
      "_doc": "MUST run last — hashes the dist artifacts above to derive BUILD_HASH and inject it into the SW bundle.",
      "mod": "esbuild_sw",
      "input": "src/typescript/script-service-worker.ts",
      "output": "script-service-worker.js",
      "format": "iife",
      "target": "es2020",
      "hash_of": [
        "index.html",
        "script.js",
        "style.css"
      ],
      "precache": [
        "./",
        "./index.html",
        "./script.js",
        "./style.css"
      ]
    }
  ],
  "serve": {
    "mode": "auto",
    "dir": "src",
    "watch": [
      {
        "mod": "sass",
        "input": "scss/main.scss",
        "output": "style.css"
      },
      {
        "mod": "esbuild",
        "input": "typescript/main.ts",
        "output": "script.js",
        "format": "iife",
        "target": "es2020"
      }
    ]
  },
  "deploy": {},
  "_resolved": {
    "path": "a-Portals/linktree_icon-view",
    "category": "a-Portals",
    "project": "linktree_icon-view",
    "key": "a-Portals__linktree_icon-view",
    "port": 8020,
    "framework": "vanilla",
    "src": "src",
    "dist": "dist",
    "analytics": {
      "matomo": {
        "container_id": "container_odwLIyPV",
        "url": "https://analytics.diegonmarcos.com/matomo/js/container_odwLIyPV.js"
      },
      "umami": {
        "site_id": "937cbde7-5ec2-450c-9d6a-8117423ac12f",
        "url": "https://analytics.diegonmarcos.com/umami/script.js"
      }
    },
    "deploy": {
      "deployed": true,
      "deploy_name": "linktree_icon-view",
      "url": "https://diegonmarcos.github.io/linktree_icon-view"
    },
    "consumers": [],
    "has_package_json": true,
    "has_manifest": false
  }
}
